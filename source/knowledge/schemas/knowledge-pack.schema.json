{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Care View Knowledge Pack",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "sourceVersion",
    "sourceTitle",
    "generatedAt",
    "kind",
    "sources",
    "items"
  ],
  "properties": {
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "sourceVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "sourceTitle": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "generatedAt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "kind": {
      "enum": ["original", "licensed"]
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "url"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          }
        }
      }
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "concepts",
          "terms",
          "assessment23",
          "target",
          "question",
          "purpose",
          "sourceRefs"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,40}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "concepts": {
            "type": "array",
            "minItems": 1,
            "maxItems": 15,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            }
          },
          "terms": {
            "type": "array",
            "minItems": 1,
            "maxItems": 40,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 50
            }
          },
          "assessment23": {
            "type": "array",
            "maxItems": 23,
            "items": {
              "type": "integer",
              "minimum": 1,
              "maximum": 23
            }
          },
          "target": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "question": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "purpose": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "sourceRefs": {
            "type": "array",
            "minItems": 1,
            "maxItems": 10,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            }
          }
        }
      }
    }
  }
}
